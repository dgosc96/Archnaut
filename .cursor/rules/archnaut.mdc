  edges: Array<{ id: string; from: string; to: string; type: "depends_on"|"calls"|"reads_writes"|"publishes"|"subscribes"|"owns"; status: "planned"|"implemented"; metadata?: { description?: string; }; }>;
  concerns: Array<{ id: string; scope: string; severity: "low"|"medium"|"high"; status: "open"|"resolved"; source: "agent"|"human"; description: string; }>;
